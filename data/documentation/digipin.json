r {","    print(\"Error code:\", error)","    print(\"Error description:\", error.localizedDescription)","} catch {","    print(\"Unexpected error:\", error)","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The decoder accepts lowercase input and separator characters (such as "},{"code":"-","type":"codeVoice"},{"type":"text","text":"), and rejects invalid symbols or malformed DIGIPIN strings."}]},{"type":"paragraph","inlineContent":[{"text":"Encoding and decoding operations throw ","type":"text"},{"code":"DigipinError","type":"codeVoice"},{"text":" on failure.","type":"text"}]},{"type":"heading","anchor":"Platform-Support","text":"Platform Support","level":2},{"type":"paragraph","inlineContent":[{"text":"Digipin is implemented entirely in Swift, has no platform-specific or system-level dependencies, and can be used on any platform supported by Swift.","type":"text"}]}]}],"references":{"doc://Digipin/documentation/Digipin/DigipinError":{"kind":"symbol","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"DigipinError","kind":"identifier"}],"url":"\/documentation\/digipin\/digipinerror","type":"topic","title":"DigipinError","role":"symbol","abstract":[{"type":"text","text":"Errors returned by DIGIPIN operations."}],"navigatorTitle":[{"text":"DigipinError","kind":"identifier"}],"identifier":"doc:\/\/Digipin\/documentation\/Digipin\/DigipinError"},"digipin-social-preview":{"variants":[{"traits":["1x","light"],"url":"\/images\/Digipin\/digipin-social-preview.png"}],"alt":"DIGIPIN Logo","type":"image","identifier":"digipin-social-preview"},"doc://Digipin/documentation/Digipin":{"title":"Digipin","role":"collection","type":"topic","kind":"symbol","abstract":[{"text":"A Swift implementation of India’s Digital Postal Index Number (DIGIPIN).","type":"text"}],"identifier":"doc:\/\/Digipin\/documentation\/Digipin","url":"\/documentation\/digipin"},"doc://Digipin/documentation/Digipin/Location":{"navigatorTitle":[{"